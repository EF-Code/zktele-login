# Copy to .env.local, chmod 600, and set TELEGRAM_BOT_TOKEN.
# For the easiest local fixture demo, use: npm run demo
NODE_ENV=development
SERVICE_ROLE=combined
ALLOW_DEV_INIT=false
ENVIRONMENT_ID=local-telegram
PORT=3000
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
APP_DOMAIN=local.zktele-login
ACTION_ID=login-v1
GATEWAY_ISSUER=local-gateway
GATEWAY_KEY_ID=local-key
ATTESTATION_AUDIENCE=local.zktele-login
CIRCUIT_ID=telegram-auth
CIRCUIT_VERSION=2
ARTIFACT_SET_ID=local-artifacts
TELEGRAM_BOT_TOKEN=
NULLIFIER_SECRET=<base64-32-byte-secret>
SESSION_SECRET=<base64-32-byte-secret>
DATABASE_URL=postgresql://zktele_local:local-development-only@127.0.0.1:55432/zktele
DATABASE_SSL=false
PROOF_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=120
